# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Security: OWASP A02 - Do not commit secrets or real production credentials.
# Copy this file to .env and adjust variables as required.

# Server & Application Runtime
NODE_ENV=production
PORT=3000

# Database Configuration (SQLite)
# In Docker container: /app/data/todos.sqlite
# In Local Dev: ./data/todos.sqlite
DB_PATH=./data/todos.sqlite

# Static Asset Serving (Frontend Build)
# In Docker container: /app/frontend/dist
# In Local Dev: ../frontend/dist
STATIC_DIR=../frontend/dist

# Security & CORS Settings (Comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting (Throttling)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
